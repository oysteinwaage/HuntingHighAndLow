{
  "rules": {
    "experiences": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "huntDates": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "teamPhotos": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('roles').child('0').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('1').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('2').val() === 'ADMIN')"
    },
    "catchReports": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('roles').child('0').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('1').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('2').val() === 'ADMIN')",
      "$year": {
        "huntDays": {
          ".write": "auth != null"
        }
      }
    },
    "songs": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "shoppingLists": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "shoppingTemplate": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "prepLists": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('roles').child('0').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('1').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('2').val() === 'ADMIN')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('roles').child('0').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('1').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('2').val() === 'ADMIN')",
        "$year": {
          "items": {
            "$itemId": {
              ".write": "auth != null && (auth.uid === $uid || newData.child('addedBy').val() === auth.uid || data.child('addedBy').val() === auth.uid)"
            }
          }
        }
      }
    },
    "prepTemplate": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "packingTemplate": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "packingLists": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('roles').child('0').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('1').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('2').val() === 'ADMIN')"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('roles').child('0').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('1').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('2').val() === 'ADMIN')"
      }
    },
    "feedback": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('roles').child('0').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('1').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('2').val() === 'ADMIN')",
      "$feedbackId": {
        ".write": "auth != null && (!data.exists() || root.child('users').child(auth.uid).child('roles').child('0').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('1').val() === 'ADMIN' || root.child('users').child(auth.uid).child('roles').child('2').val() === 'ADMIN')"
      }
    }
  }
}
